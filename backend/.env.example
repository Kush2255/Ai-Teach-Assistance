# AI Teacher Backend Configuration

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=True

# LLM Providers (At least one key recommended for AI generation; smart local fallback available)
GROK_API_KEY=gsk_your_groq_api_key_here          # Groq (api.groq.com)
GEMINI_API_KEY=your_gemini_api_key_here          # Google AI Studio (gemini-3.6-flash)
OPENAI_API_KEY=your_openai_api_key_here          # OpenAI (gpt-4o / gpt-3.5-turbo)
DEFAULT_LLM_PROVIDER=gemini                      # gemini, grok, or openai

# Video & Realistic AI Avatar Providers
AI_TEACHER_PROVIDER=mock                         # mock, heygen, or did
AI_VIDEO_PROVIDER=mock                           # mock, heygen, did, or streaming
AI_VIDEO_API_KEY=your_video_api_key_here
AI_VIDEO_MODEL=default
AI_TEACHER_ID=dr_sarah_adams
AI_TEACHER_VOICE_ID=en-US-Neural-Studio
AI_TEACHER_API_KEY=your_teacher_provider_key
AI_TEACHER_AVATAR_ID=default_educator
HEYGEN_API_KEY=your_heygen_api_key_here
DID_API_KEY=your_did_api_key_here

# Vector DB & Storage
DATA_DIR=./data
DATABASE_URL=sqlite:///./ai_teacher.db
